# BHOOT Filesystem Table (fstab)
# Core system root (OverlayFS) and persistence (/var/bhoot) are managed by Debian live-boot.
# <file system>    <mount point>   <type>      <options>                                                   <dump>  <pass>

# EFI System Partition (read-only, on-demand mount with nofail to prevent boot block)
LABEL=BHOOT_EFI    /boot/efi       vfat        ro,nodev,nosuid,noexec,fmask=0177,dmask=0077,nofail,noauto    0       0

# Volatile In-Memory Directories (RAM only - zero disk write traces)
tmpfs              /tmp            tmpfs       defaults,nosuid,nodev,noexec,mode=1777,size=2G                0       0
tmpfs              /run            tmpfs       defaults,nosuid,nodev,mode=0755,size=1G                       0       0
devpts             /dev/pts        devpts      defaults,gid=5,mode=620,noexec,nosuid                         0       0
proc               /proc           proc        defaults,nosuid,nodev,noexec,hidepid=2                        0       0
sysfs              /sys            sysfs       defaults,nosuid,nodev,noexec                                  0       0
