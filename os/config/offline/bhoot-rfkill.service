[Unit]
Description=BHOOT Hardware RFKill Wireless and Bluetooth Hard-Block
DefaultDependencies=no
Before=sys-subsystem-net-devices.target network-pre.target basic.target
After=systemd-modules-load.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=-/usr/sbin/rfkill block all
ExecStartPost=-/bin/sh -c 'for dev in $(ip -o link show | awk -F": " "{print \$2}"); do [ "$dev" != "lo" ] && ip link set dev "$dev" down || true; done'

[Install]
WantedBy=basic.target

